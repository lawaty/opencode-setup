node_modules/
bun.lock
*.log

# The context map is a derived artifact, regenerated by context-manager and
# resolved per project from the session directory. Committing it would churn on
# every session that edits a file; syncing it would push a description of this
# host's projects onto hosts that have different ones. See OPERATIONS.md.
.opencode/context/

# Credentials never belong here. opencode keeps auth in
# ~/.local/share/opencode/auth.json, outside this directory, but guard anyway.
auth.json
.env
.env.*
# ...except the template, which carries no host details and documents the vars.
!.env.example
*.pem
*.key