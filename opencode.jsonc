      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore-deep": "allow"
        }
      }
    },
    "explore-deep": {
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Last-resort read-only exploration for genuinely hard problems @explore-fast fails on. Most expensive explore tier — use deliberately.",
      "mode": "subagent",
      "temperature": 0.2,
      "tools": {
        "playwright_*": true
      },
      "prompt": "{file:./.opencode/prompts/explore-deep.txt}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow",
        "task": {
          "*": "deny"
        }
      }
    },
    "implement-fast": {
      "model": "opencode/big-pickle",
      "description": "Default agent that executes a finalized plan. Escalates to @implement-deep when stuck or looping.",
      "mode": "subagent",
      "temperature": 0.2,
      "tools": {
        "playwright_*": true
      },
      "prompt": "{file:./.opencode/prompts/implement-fast.txt}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "implement-deep": "allow"
        }
      }
    },
    "implement-deep": {
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Last-resort executor for genuinely hard problems @implement-fast fails on. Most expensive implement tier — use deliberately.",
      "mode": "subagent",
      "temperature": 0.2,
      "tools": {
        "playwright_*": true
      },
      "prompt": "{file:./.opencode/prompts/implement-deep.txt}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow",
        "task": {
          "*": "deny"
        }
      }
    },
    "context-manager": {
      "model": "opencode/big-pickle",
      "description": "Repository cartographer and memory maintainer. Bootstraps and incrementally maintains .opencode/context/ (architecture, contexts, conventions, workflows, decisions) as a small navigation map for future agents. Runs automatically after sessions that changed files; can also be invoked with /context-init, /context-update, /context-review. Never use it for general coding tasks.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompts/context-manager.txt}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": {
          "*": "deny",
          "*/.opencode/context/**": "allow",
          ".opencode/context/**": "allow"
        },
        "write": {
          "*": "deny",
          "*/.opencode/context/**": "allow",
          ".opencode/context/**": "allow"
        },
        "bash": {
          "*": "deny",
          "ls": "allow",
          "ls *": "allow",
          "pwd": "allow",
          "cat *": "allow",
          "find *": "allow",
          "fd *": "allow",
          "tree *": "allow",
          "wc *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "stat *": "allow",
          "file *": "allow",
          "du *": "allow",
          "git status*": "allow",
          "git log*": "allow",
          "git ls-files*": "allow",
          "git show*": "allow",
          "git diff*": "allow",
          "git blame*": "allow",
          "git grep*": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "rg": "allow",
          "echo *": "allow",
          "sort*": "allow",
          "uniq*": "allow",
          "wc": "allow",
          "which *": "allow",
          "date": "allow",
          "mkdir -p *": "deny"
        },
        "external_directory": {
          "*": "deny",
          "$HOME/.local/share/opencode/tool-output/*": "allow"
        },
        "webfetch": "deny",
        "websearch": "deny",
        "question": "deny",
        "task": {
          "*": "deny"
        }
      }
    },
    "implement-fast-1": {
      "description": "hidden pool variant implement-fast-1: slot 1. Its model is NOT set here -- plugins/agent-pool.ts injects it from pool-models.json at config time, so that file is the only place the pool models live. Spawn 'implement-fast' and let the pool route.",
