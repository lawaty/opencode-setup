        "edit": "deny",
        "write": "deny",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore-deep": "allow"
        }
      }
    },
    "explore-fast-4": {
      "description": "hidden pool variant explore-fast-4: slot 4. Its model is NOT set here -- plugins/agent-pool.ts injects it from pool-models.json at config time, so that file is the only place the pool models live. Spawn 'explore-fast' and let the pool route.",
      "mode": "subagent",
