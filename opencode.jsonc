{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 4,
  "model": "opencode/big-pickle",
  "agent": {
    "explore": { "disable": true },
    "general": { "disable": true },
    "implement": { "disable": true },
    "basic": {
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Default thinking agent. Read-only by design: it may only delegate to explore-fast* / implement-fast* and ask questions. expert is deliberately NOT spawnable from here (root sessions only), so do not promise that escalation.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompts/plan.txt}",
      "permission": {
        "read": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore-fast*": "allow",
          "implement-fast*": "allow"
        }
      }
    },
    "expert": {
      "model": "opencode-go/glm-5.2",
      "description": "Last resort for genuinely hard problems the fast tiers fail on. Untested in the 2026-09-20 head-to-head — first real escalation is effectively also its first benchmark. Most expensive agent (880 req/5h) — use deliberately.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompts/plan.txt}",
      "permission": {
        "read": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore-fast*": "allow",
          "implement-fast*": "allow",
          "explore-deep": "allow",
          "implement-deep": "allow"
        }
      }
    },
    "explore-fast": {
      "model": "opencode/big-pickle",
      "description": "Default read-only codebase exploration. Free via Zen. Escalates to @explore-deep when stuck or looping.",
      "mode": "subagent",
      "temperature": 0.2,
      "tools": {
        "playwright_*": true
      },
      "prompt": "{file:./.opencode/prompts/explore-fast.txt}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore-deep": "allow"
        }
      }
    },
    "explore-fast-1": {
      "description": "hidden pool variant explore-fast-1: slot 1. Its model is NOT set here -- plugins/agent-pool.ts injects it from pool-models.json at config time, so that file is the only place the pool models live. Spawn 'explore-fast' and let the pool route.",
      "mode": "subagent",
      "hidden": true,
      "temperature": 0.2,
      "tools": {
        "playwright_*": true
      },
      "prompt": "{file:./.opencode/prompts/explore-fast.txt}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow",
        "task": {
          "*": "deny",
          "explore-deep": "allow"
        }
      }
    },
