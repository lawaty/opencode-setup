#!/usr/bin/env bash
# oc-sync — distribute the `oc` helper AND the whole opencode config to the
# remote hosts listed in .env.
#
# Usage:
# The DEFAULT is --with-config. Syncing only `oc` leaves every host running the
# old global AGENTS.md, so agents there skip the .opencode/context map while the
# local machine enforces it -- the drift that shipped a fix nobody received.
#
#   bin/oc-sync                 sync `oc` AND the whole opencode config to every host
#   bin/oc-sync --scripts-only  sync only `oc`, skipping the config
#   bin/oc-sync --no-config     alias for --scripts-only
#   bin/oc-sync --with-auth     also copy MISSING provider credentials into each host's
#                               opencode auth.json (merge-only: never overwrites a key a
#                               host already has, and never prints one)
#   bin/oc-sync --dry-run ...   show what would change, write nothing
#   bin/oc-sync --host NAME ... limit to one host
#
# Also provisions the oc-notify tunnel key pair, which notifications depend on:
# a dedicated key (~/.ssh/oc_notify), never your personal key, restricted on this
# machine's authorized_keys to a forced command that can only raise a notification.
#
# Host details are NOT in this file: this repo is public. They live in .env
# (gitignored), e.g. OC_HOSTS="host-a host-b"; see .env.example for every
# variable. If OC_HOSTS is unset the script falls back to ~/.oc-hosts.
#
# Why it is shaped this way:
#   * Command latency on these boxes varies wildly (measured 1.4s to 23s per
#     remote command). The original made ~12 ssh calls per host, so a slow host
#     took minutes and looked like a hang. All remote preparation now happens in
#     ONE ssh call that runs a small script and prints a log.
#   * Reaching a host by raw IP cost ~11.4s per call versus ~1.4s via its
#     ssh-config alias, so OC_HOSTS lists aliases, not addresses.
#   * A failing host must not abort the run, so nothing relies on `set -e`.
#   * Every ssh is wrapped in `timeout`; rc edits are idempotent.
#
# Credentials are NOT part of --with-config, deliberately: the pool spans providers
# (Zen, openrouter, ...), and a host missing one silently fails every task routed
# to it. But the keys are per-host, not shared -- each host carries its own Zen/Go
# keys, which differ from this machine's (see .env) -- so pushing this
# machine's whole auth.json would replace credentials those hosts depend on.
# --with-auth therefore MERGES: a host receives only the providers it lacks, and an
# existing key is never overwritten. Keys travel over the ssh that is already being
# used, are never written to disk here, and are never echoed: output names the
# provider and nothing else.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"

# .env is gitignored and parsed as shell assignments, so OC_HOSTS and friends can
# be set there instead of exported by the caller. Sourced before the defaults
# below, so .env wins when both are present; with no .env, exported variables
# work on their own.
ENV_FILE="${OC_SYNC_ENV_FILE:-$REPO_DIR/.env}"
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

HOSTS_FILE="${OC_HOSTS_FILE:-$HOME/.oc-hosts}"
OC_SCRIPT="${OC_SCRIPT:-$SCRIPT_DIR/oc}"
CONFIG_DIR="${OC_SYNC_CONFIG_DIR:-$REPO_DIR}"
LOCAL_USER="${OC_LOCAL_USER:-$(whoami)}"
SSH_TIMEOUT="${OC_SYNC_SSH_TIMEOUT:-90}"
RSYNC_TIMEOUT="${OC_SYNC_RSYNC_TIMEOUT:-120}"
# -o ClearAllForwardings=yes: oc-sync makes many short ssh calls per host, and a
# RemoteForward in ~/.ssh/config means every one of them tries to claim port
# 10022. After the first, the rest print "remote port forwarding failed" -- noise
# here, and worse, the failed claim can leave a listener that blocks the one
# session that actually needs the tunnel to notify you. This script never needs a
# forward; the interactive `oc` session does, and it makes its own connection.
SSH_SSH_OPTS=(-o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=15 -o ClearAllForwardings=yes)
SSH_BASE=(ssh -n "${SSH_SSH_OPTS[@]}")
# remote_prepare feeds a script on stdin, so it must NOT use -n.
SSH_STDIN=(ssh "${SSH_SSH_OPTS[@]}")

WITH_CONFIG=1
WITH_AUTH=0
DRY_RUN=0
ONLY_HOST=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --with-config|--config) WITH_CONFIG=1 ;;
    --scripts-only|--no-config) WITH_CONFIG=0 ;;
    --with-auth) WITH_AUTH=1 ;;
    --dry-run|-n)  DRY_RUN=1 ;;
    --host)        ONLY_HOST="${2:-}"; shift ;;
    -h|--help)     awk '/^# Usage:/{p=1;next} /^# (Host details|Why it is|Credentials|$)/{if(p)exit} p{sub(/^# ?/,"");print}' "$0"; exit 0 ;;
    *)             echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

ok()   { printf '  \xe2\x9c\x93 %s\n' "$*"; }
bad()  { printf '  \xe2\x9c\x97 %s\n' "$*"; }
warn() { printf '  \xe2\x9a\xa0 %s\n' "$*"; }

# rsync with the same ssh options, and --dry-run folded in. rsync's progress
# lines are noise here, but the transfer's exit status is the whole point: a
# filtered pipe reports success for a transfer that never happened, so the
# status is captured before filtering and returned to the caller.
rsync_to() {
  local src="$1" dest="$2"
  shift 2
  local args=(-az --no-owner --no-group)
  [[ $DRY_RUN -eq 1 ]] && args+=(-n)
  local out="" status=0
  out="$(timeout "$RSYNC_TIMEOUT" rsync "${args[@]}" "$@" \
    -e "ssh -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=15 -o ClearAllForwardings=yes" \
    "$src" "$dest" 2>&1)" || status=$?
  printf '%s\n' "$out" | grep -vE 'using port|^$|^sending |^sent |^total size' || true
  return "$status"
}

# One rsync, with its failure reported and remembered, so a half-synced host can
# never be announced as done.
push() {
  local label="$1" src="$2" dest="$3"
  shift 3
  if rsync_to "$src" "$dest" "$@"; then
    ok "$label synced"
    return 0
  fi
  bad "rsync of $label FAILED ($src -> $dest) - remote copy is not up to date"
  FAILED+=("$HOST")
  return 1
}

# Host list: OC_HOSTS (whitespace or newline separated) wins, else the legacy
# ~/.oc-hosts file. Blank lines and # comments are ignored either way.
HOSTS=()
if [[ -n "${OC_HOSTS:-}" ]]; then
  # One host per line, or any mix of spaces, tabs, commas and newlines.
  mapfile -t HOSTS < <(printf '%s\n' "$OC_HOSTS" | tr ',[:space:]' '\n' | grep -v '^[[:space:]]*$')
elif [[ -f "$HOSTS_FILE" ]]; then
  mapfile -t HOSTS < <(sed -e 's/#.*$//' -e 's/[[:space:]]*$//' "$HOSTS_FILE" | grep -v '^$')
fi

if [[ ${#HOSTS[@]} -eq 0 ]]; then
  echo "Error: no hosts configured."
  echo "  Set OC_HOSTS in $ENV_FILE (see .env.example), or point OC_HOSTS_FILE at a list."
  exit 1
fi

# ---------------------------------------------------------------------------
# Tunnel auth for oc-notify.
#
# A remote `oc` notifies this machine by ssh-ing back through the RemoteForward
# and running a forced command. Two things must exist for that to authenticate:
#
#   ~/.ssh/oc_notify         a DEDICATED key pair. Deliberately not your personal
#                            key: this private half is copied to every host, and
#                            it must not be able to open a shell here.
#   ~/.local/bin/oc-notify-receiver
#                            the forced command it is restricted to.
#
# The authorized_keys entry carries `restrict` plus command=, so the tunnel key
# can raise a notification and nothing else -- no shell, no PTY, no forwarding.
# Both halves are idempotent: a second run rewrites the entry instead of
# appending a duplicate.
# ---------------------------------------------------------------------------

TUNNEL_KEY="$HOME/.ssh/oc_notify"
RECEIVER="$HOME/.local/bin/oc-notify-receiver"
RECEIVER_SRC="$SCRIPT_DIR/oc-notify-receiver"

setup_tunnel_auth() {
  if [[ ! -f "$TUNNEL_KEY" ]]; then
    if [[ $DRY_RUN -eq 1 ]]; then
      ok "[dry-run] would generate dedicated tunnel key $TUNNEL_KEY"
      return 0
    fi
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    if ! ssh-keygen -t ed25519 -N '' -C "oc-notify tunnel auth" -f "$TUNNEL_KEY" >/dev/null 2>&1; then
      bad "could not generate $TUNNEL_KEY -- remote notifications will not work"
      return 1
    fi
    ok "generated dedicated tunnel key $TUNNEL_KEY"
  fi

  # The receiver lives in ~/.local/bin, not the repo: it executes on the desktop.
  if [[ -f "$RECEIVER_SRC" ]] && [[ ! -f "$RECEIVER" ]]; then
    if [[ $DRY_RUN -eq 1 ]]; then
      ok "[dry-run] would install oc-notify-receiver -> $RECEIVER"
    else
      mkdir -p "$(dirname -- "$RECEIVER")"
      if cp "$RECEIVER_SRC" "$RECEIVER" && chmod 700 "$RECEIVER"; then
        ok "installed oc-notify-receiver"
      else
        bad "could not install $RECEIVER -- remote notifications will not work"
        return 1
      fi
    fi
  fi

  local entry
  entry="restrict,command=\"$RECEIVER\" $(cat "$TUNNEL_KEY.pub")"
  if grep -qF "$RECEIVER" "$HOME/.ssh/authorized_keys" 2>/dev/null; then
    ok "tunnel key already restricted to $RECEIVER"
  elif [[ $DRY_RUN -eq 1 ]]; then
    ok "[dry-run] would restrict the tunnel key to $RECEIVER in ~/.ssh/authorized_keys"
  # A pre-existing entry pointing at a receiver that has since moved is stale:
  # the host holds a key that can no longer authenticate, so notifications fail
  # with a permission error. Rewriting the line fixes it in place.
  elif grep -q "oc-notify" "$HOME/.ssh/authorized_keys" 2>/dev/null; then
    local tmp="$HOME/.ssh/authorized_keys.ocsync.$$"
    if grep -vF "$RECEIVER" "$HOME/.ssh/authorized_keys" | grep -v "oc-notify tunnel auth" > "$tmp"; then
      if printf '%s\n' "$entry" >> "$tmp" && mv "$tmp" "$HOME/.ssh/authorized_keys"; then
        chmod 600 "$HOME/.ssh/authorized_keys"
        ok "re-pointed a stale tunnel key entry at $RECEIVER"
      else
        rm -f "$tmp"
        bad "could not update the stale tunnel key entry in ~/.ssh/authorized_keys"
        return 1
      fi
    else
      rm -f "$tmp"
      bad "could not rewrite ~/.ssh/authorized_keys"
      return 1
    fi
  else
    touch "$HOME/.ssh/authorized_keys"
    if printf '%s\n' "$entry" >> "$HOME/.ssh/authorized_keys"; then
      chmod 600 "$HOME/.ssh/authorized_keys"
      ok "restricted the tunnel key to $RECEIVER (forced command, no shell)"
    else
      bad "could not update ~/.ssh/authorized_keys -- remote notifications will not work"
      return 1
    fi
  fi
}

setup_tunnel_auth
TUNNEL_AUTH_FAILED=$?

[[ -f "$OC_SCRIPT" ]] || { echo "Error: $OC_SCRIPT not found (set OC_SCRIPT to the oc helper)." >&2; exit 1; }
if [[ $WITH_CONFIG -eq 1 && ! -f "$CONFIG_DIR/opencode.jsonc" ]]; then
  echo "Error: $CONFIG_DIR/opencode.jsonc not found; cannot sync config." >&2
  exit 1
fi

# One ssh call per host: report identity, ensure ~/bin, put ~/bin on PATH,
# and set OC_LOCAL_USER. Prints "oc-sync|..." lines the caller renders.
remote_prepare() {
  local host="$1"
  timeout "$SSH_TIMEOUT" "${SSH_STDIN[@]}" "$host" bash -s -- "$LOCAL_USER" "$DRY_RUN" <<'REMOTE'
set -u
LOCAL_USER="$1"
# 1 = preview only: every mutation below is reported instead of performed, so
# that "nothing was written" is true of the remote host too.
DRY="$2"
emit() { echo "oc-sync|$1"; }
# add_line <rc-file> <exact-line> <what>
add_line() {
  [ -f ~/"$1" ] || return 0
  if grep -qxF "$2" ~/"$1" 2>/dev/null; then
    emit "ok:$3 already in ~${1}"
  elif [ "$DRY" = "1" ]; then
    emit "ok:[dry-run] would add $3 to ~${1}"
  elif printf '%s\n' "$2" >> ~/"$1" 2>/dev/null; then
    emit "ok:$3 added to ~${1}"
  else
    emit "warn:could not update ~${1}"
  fi
}
if [ "$DRY" = "1" ]; then
  if [ -d ~/bin ]; then emit "ok:~/bin exists"; else emit "ok:[dry-run] would create ~/bin"; fi
else
  mkdir -p ~/bin 2>/dev/null && emit "ok:ensured ~/bin exists" || emit "err:could not create ~/bin"
fi
case ":${PATH}:" in
  *":${HOME}/bin:"*) emit "ok:~/bin already in PATH" ;;
  *)
    PATH_LINE='export PATH="$HOME/bin:$PATH"'
    for RC in .bashrc .profile; do add_line "$RC" "$PATH_LINE" "~/bin PATH"; done ;;
esac
OC_LINE="export OC_LOCAL_USER=${LOCAL_USER}"
for RC in .bashrc .profile; do add_line "$RC" "$OC_LINE" "OC_LOCAL_USER=${LOCAL_USER}"; done
REMOTE
}

FAILED=()
DONE=()

# ---------------------------------------------------------------------------
# Credentials: merge only, and never reveal a key.
#
# opencode reads auth.json from its data dir, not from the config repo, so this is
# the one thing --with-config cannot carry. A host missing a provider the pool
# routes to fails every task sent to it, with a message ("API key is missing")
# that looks like a model bug rather than a provisioning gap.
#
# Merge, do not copy. Each host's keys are its own; replacing them with this
# machine's would break hosts that are working today. So for each host we ask
# which providers it already has, and send only the remainder. The merge happens
# in python on the far side, reading the new entries from stdin, so a key is
# never written to a temp file here and never appears in a command line (where
# it would land in the remote shell history and in this process's argv).
AUTH_FILE="${OC_AUTH_FILE:-$HOME/.local/share/opencode/auth.json}"

# Names only: provider -> its key, for the ones listed in $2. Used to build the
# payload without ever printing a key.
auth_subset() {
  python3 - "$AUTH_FILE" "$@" <<'PY'
import json, sys
path = sys.argv[1]
want = set(sys.argv[2:])
try:
    with open(path) as fh:
        auth = json.load(fh)
except FileNotFoundError:
    sys.exit(3)
out = {k: v for k, v in auth.items() if (not want or k in want) and isinstance(v, dict) and v.get("key")}
print(json.dumps(out))
PY
}

# Providers the host already has, one per line, via the ssh already in use.
remote_auth_providers() {
  timeout "$SSH_TIMEOUT" "${SSH_BASE[@]}" "$1" \
    'python3 -c "
import json, os, sys
p = os.path.expanduser(\"~/.local/share/opencode/auth.json\")
try:
    d = json.load(open(p))
except Exception:
    sys.exit(0)
print(\" \".join(k for k, v in d.items() if isinstance(v, dict) and v.get(\"key\")))
"' 2>/dev/null
}

# Merge the missing providers into the host auth.json.
#
# The payload is embedded in the script body rather than piped in beside it. ssh
# has exactly one stdin, and it is already carrying the script that bash -s
# executes, so a second stream is not available; a heredoc inside the generated
# script gives the payload its own place without ever putting it in argv (where
# it would show up in the remote process table) or in a temp file. The key lives
# only in this shell's memory and in the ssh pipe.
#
# Writes nothing unless the merge succeeds, keeps a timestamped backup, and prints
# "oc-auth|..." lines the caller renders: provider names, never keys.
remote_auth_merge() {
  local host="$1" payload="$2"
  # One line, so it cannot collide with the heredoc terminator below.
  [[ "$payload" != *$'\n'* ]] || { echo "oc-auth|err:payload must be single-line"; return 1; }
  {
    printf 'set -u\n'
    printf 'DRY=%q\n' "$DRY_RUN"
    printf 'AUTH="$HOME/.local/share/opencode/auth.json"\n'
    printf 'emit() { echo "oc-auth|$1"; }\n'
    printf 'mkdir -p "$(dirname "$AUTH")" || { emit "err:could not create auth dir"; exit 0; }\n'
    printf "PAYLOAD=\$(cat <<'PAYLOAD_EOF'\n"
    printf '%s\n' "$payload"
    printf 'PAYLOAD_EOF\n)\n'
    cat <<'REMOTE_TAIL'
[ -n "$PAYLOAD" ] || { emit "warn:empty payload, nothing merged"; exit 0; }
if [ "$DRY" = "1" ]; then
  PROVIDERS="$(printf '%s' "$PAYLOAD" | python3 -c 'import json,sys; print(" ".join(sorted(json.load(sys.stdin))))')"
  emit "ok:[dry-run] would add $PROVIDERS to ~auth.json"
  exit 0
fi
# Merge in python so a malformed payload cannot truncate the file: the existing
# store is read, updated, and only then written via a temp file + rename, which
# is atomic, so a crash mid-write leaves the original intact.
printf '%s' "$PAYLOAD" | python3 -c '
import json, os, shutil, sys, time
auth_path = os.path.expanduser("~/.local/share/opencode/auth.json")
new = json.load(sys.stdin)
if not isinstance(new, dict) or not new:
    print("REJECT:payload is not a non-empty object"); raise SystemExit(0)
try:
    cur = json.load(open(auth_path))
    if not isinstance(cur, dict):
        raise ValueError("existing auth.json is not an object")
except FileNotFoundError:
    cur = {}
except Exception as e:
    print("REJECT:existing auth.json unreadable (%s)" % e); raise SystemExit(0)
# never overwrite: a key the host already has wins over ours
added = [k for k in new if k not in cur]
kept = [k for k in new if k in cur]
cur.update({k: v for k, v in new.items() if k in added})
shutil.copy2(auth_path, auth_path + ".bak-" + time.strftime("%Y%m%d-%H%M%S"))
tmp = auth_path + ".tmp"
with open(tmp, "w") as fh:
    json.dump(cur, fh, indent=2)
    fh.write("\n")
os.chmod(tmp, 0o600)
os.replace(tmp, auth_path)
print("ADDED:" + " ".join(sorted(added)))
if kept:
    print("KEPT:" + " ".join(sorted(kept)))
'
rc=$?
[ $rc -eq 0 ] || emit "err:merge helper failed"
REMOTE_TAIL
  } | timeout "$SSH_TIMEOUT" "${SSH_STDIN[@]}" "$host" bash -s
}

sync_auth() {
  local host="$1"
  if [[ ! -f "$AUTH_FILE" ]]; then
    warn "no local auth.json at $AUTH_FILE; run 'opencode auth login' first"
    FAILED+=("$host")
    return 1
  fi
  local have payload
  have="$(remote_auth_providers "$host")"
  local -a missing=()
  local provider
  for provider in $(auth_subset | python3 -c 'import json,sys; print(" ".join(sorted(json.load(sys.stdin))))'); do
    case " $have " in *" $provider "*) ;; *) missing+=("$provider") ;; esac
  done
  if [[ ${#missing[@]} -eq 0 ]]; then
    ok "auth: host already has ${have:-no providers}, nothing to add"
    return 0
  fi
  payload="$(auth_subset "${missing[@]}")" || { bad "could not read $AUTH_FILE"; FAILED+=("$host"); return 1; }
  local out
  out="$(remote_auth_merge "$host" "$payload")" || { bad "auth merge failed on $host"; FAILED+=("$host"); return 1; }
  local line reported=0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local msg="${line#oc-sync|}"
    case "$msg" in
      ok:*)   ok "auth: ${msg#ok:}"; reported=1 ;;
      warn:*) warn "auth: ${msg#warn:}"; reported=1 ;;
      err:*)  bad "auth: ${msg#err:}"; FAILED+=("$host"); reported=1 ;;
    esac
  done <<< "$out"
  # The python helper reports the outcome on plain lines (ADDED:/KEPT:/REJECT:),
  # not through emit, so they arrive unprefixed. A missing REJECT means the merge
  # ran; silence entirely means it did not, and must not be reported as success.
  local added kept
  added="$(sed -n 's/^ADDED://p' <<< "$out")"
  kept="$(sed -n 's/^KEPT://p' <<< "$out")"
  if grep -q '^REJECT:' <<< "$out"; then
    bad "auth: merge rejected on $host (${out%%$'\n'*})"
    FAILED+=("$host")
    return 1
  fi
  [[ -n "$added" ]] && ok "auth: added $added$([ -n "$kept" ] && printf ' (kept existing: %s)' "$kept")"
  if [[ $reported -eq 0 && -z "$added" ]]; then
    bad "auth: merge produced no confirmation on $host - treat as not applied"
    FAILED+=("$host")
    return 1
  fi
}

for HOST in "${HOSTS[@]}"; do
  HOST="${HOST%$'\r'}"
  stripped="${HOST//[[:space:]]/}"
  [[ -z "$stripped" || "$HOST" == \#* ]] && continue
  [[ -n "$ONLY_HOST" && "$HOST" != "$ONLY_HOST" ]] && continue

  echo "━━━ Syncing to $HOST ━━━"

  PREP="$(remote_prepare "$HOST")"
  if [[ -z "$PREP" ]]; then
    bad "unreachable or too slow (>${SSH_TIMEOUT}s) - skipping, run continues"
    FAILED+=("$HOST")
    continue
  fi
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    msg="${line#oc-sync|}"
    case "$msg" in
      ok:*)   ok "${msg#ok:}" ;;
      warn:*) warn "${msg#warn:}" ;;
      err:*)  bad "${msg#err:}"; FAILED+=("$HOST") ;;
    esac
  done <<< "$PREP"

  if [[ " ${FAILED[*]-} " == *" $HOST "* ]]; then
    continue
  fi

  if [[ $DRY_RUN -eq 1 ]]; then
    ok "[dry-run] would rsync oc, oc-notify -> ~/bin/"
    [[ $TUNNEL_AUTH_FAILED -eq 0 && -f "$TUNNEL_KEY" ]] && ok "[dry-run] would send tunnel key -> ~/.ssh/oc_notify"
  else
    mkdir -p "$CONFIG_DIR/bin" 2>/dev/null
    for SCRIPT in oc oc-notify; do
      [[ -f "$CONFIG_DIR/bin/$SCRIPT" ]] || continue
      if rsync -az --no-owner --no-group \
            -e "ssh -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=15 -o ClearAllForwardings=yes" \
            "$CONFIG_DIR/bin/$SCRIPT" "${HOST}:~/bin/" >/dev/null 2>&1; then
        ok "$SCRIPT synced"
      else
        bad "rsync of $SCRIPT failed"
        FAILED+=("$HOST")
        continue 2
      fi
    done
    # The private half of the dedicated tunnel key. Without it the host cannot
    # authenticate the notification hop; with it the host still cannot open a
    # shell here, because authorized_keys pins it to the receiver.
    if [[ $TUNNEL_AUTH_FAILED -eq 0 && -f "$TUNNEL_KEY" ]]; then
      if rsync -az --no-owner --no-group \
            -e "ssh -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=15 -o ClearAllForwardings=yes" \
            "$TUNNEL_KEY" "${HOST}:~/.ssh/oc_notify" >/dev/null 2>&1; then
        timeout "$SSH_TIMEOUT" "${SSH_BASE[@]}" "$HOST" 'chmod 700 ~/.ssh; chmod 600 ~/.ssh/oc_notify' >/dev/null 2>&1
        ok "tunnel key synced"
      else
        # Not fatal: the config is what must be current. Notifications on this
        # host stay broken until it is fixed, so say so rather than hide it.
        warn "could not send the tunnel key -- notifications from $HOST will fail until you re-run"
      fi
    fi
  fi

  if [[ $WITH_CONFIG -eq 1 ]]; then
    echo "  --- opencode config ---"
    if [[ $DRY_RUN -eq 1 ]]; then
      ok "[dry-run] would rsync opencode.jsonc, pool-models.json, lib/, plugins/, .opencode/, AGENTS.md, commands/, rules/ (remote backed up first)"
    else
      if timeout "$SSH_TIMEOUT" "${SSH_BASE[@]}" "$HOST" \
           "tar czf ~/opencode-config-backup-\$(date +%Y%m%d-%H%M%S).tar.gz --ignore-failed-read -C ~/.config/opencode opencode.jsonc pool-models.json .opencode plugins lib AGENTS.md commands rules 2>/dev/null" >/dev/null 2>&1; then
        ok "remote config backed up to ~/opencode-config-backup-*.tar.gz"
      else
        warn "remote backup failed - skipping config sync for this host"
        FAILED+=("$HOST")
        continue
      fi
      # lib/ must land before plugins/: the plugins import ../lib/pool.ts, so a
      # plugins-first sync would leave them unable to resolve on next restart.
      if [[ -d "$CONFIG_DIR/lib" ]]; then
        timeout "$SSH_TIMEOUT" "${SSH_BASE[@]}" "$HOST" 'mkdir -p ~/.config/opencode/lib' >/dev/null 2>&1
        push "lib/" "$CONFIG_DIR/lib/" "${HOST}:~/.config/opencode/lib/" || continue
      fi
      push "opencode.jsonc" "$CONFIG_DIR/opencode.jsonc" "${HOST}:~/.config/opencode/" || continue
      # pool-models.json decides which models the pool runs: lib/ and plugins/ read it,
      # so a host missing it silently falls back to the built-in defaults.
      if [[ -f "$CONFIG_DIR/pool-models.json" ]]; then
        push "pool-models.json" "$CONFIG_DIR/pool-models.json" "${HOST}:~/.config/opencode/" || continue
      fi
      if [[ -d "$CONFIG_DIR/plugins" ]]; then
        timeout "$SSH_TIMEOUT" "${SSH_BASE[@]}" "$HOST" 'mkdir -p ~/.config/opencode/plugins' >/dev/null 2>&1
        push "plugins/" "$CONFIG_DIR/plugins/" "${HOST}:~/.config/opencode/plugins/" || continue
      fi
      # AGENTS.md is the global instruction file opencode auto-loads into every
      # session, and commands/ + rules/ back it. Without these three a host runs
      # agents that were never told the .opencode/context map exists: one host
      # carried a 368-byte stub pointing at a rules file no config ever loaded,
      # another had no AGENTS.md at all. Both then reported skipping the map.
      if [[ -f "$CONFIG_DIR/AGENTS.md" ]]; then
        push "AGENTS.md" "$CONFIG_DIR/AGENTS.md" "${HOST}:~/.config/opencode/" || continue
      fi
      for DIR in commands rules; do
        if [[ -d "$CONFIG_DIR/$DIR" ]]; then
          timeout "$SSH_TIMEOUT" "${SSH_BASE[@]}" "$HOST" "mkdir -p ~/.config/opencode/$DIR" >/dev/null 2>&1
          push "$DIR/" "$CONFIG_DIR/$DIR/" "${HOST}:~/.config/opencode/$DIR/" || continue
        fi
      done
      if [[ -d "$CONFIG_DIR/.opencode" ]]; then
        timeout "$SSH_TIMEOUT" "${SSH_BASE[@]}" "$HOST" 'mkdir -p ~/.config/opencode/.opencode' >/dev/null 2>&1
        # .opencode/context/ is the derived map of whatever projects a host
        # works on, so each host regenerates its own and it is never shipped.
        push ".opencode/" "$CONFIG_DIR/.opencode/" "${HOST}:~/.config/opencode/.opencode/" \
          --exclude='.opencode/context/' || continue
      fi
      # node_modules / package-lock.json / tests/ are intentionally not synced:
      # each host keeps its own install and SDK version.
    fi
  fi

  if [[ $WITH_AUTH -eq 1 ]]; then
    sync_auth "$HOST"
  fi

  ok "done"
  DONE+=("$HOST")
done

# A host that neither finished nor recorded a failure was skipped by something
# unexpected (a missing helper, say). Never report that as success.
for HOST in "${HOSTS[@]}"; do
  case " ${DONE[*]-} ${FAILED[*]-} " in
    *" $HOST "*) ;;
    *) [[ -n "$ONLY_HOST" && "$HOST" != "$ONLY_HOST" ]] && continue
       bad "host $HOST was neither synced nor marked failed"
       FAILED+=("$HOST") ;;
  esac
done

echo
echo "━━━ Summary ━━━"
echo "  synced : ${DONE[*]:-none}"
if [[ ${#FAILED[@]} -gt 0 ]]; then
  echo "  failed : ${FAILED[*]}"
else
  echo "  failed : none"
fi
[[ $DRY_RUN -eq 1 ]] && echo "  dry run: nothing was written"
if [[ $WITH_CONFIG -eq 0 ]]; then
  echo
  echo "  note: --scripts-only, so AGENTS.md and the opencode config were NOT synced."
  echo "        hosts keep the global instructions they had before; re-run without the flag to bring them current."
fi
if [[ $WITH_AUTH -eq 0 ]]; then
  echo
  echo "  note: credentials were not touched; re-run with --with-auth to add any provider keys a host is missing"
fi
[[ ${#FAILED[@]} -gt 0 ]] && exit 1
exit 0