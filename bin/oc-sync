#!/usr/bin/env bash
# oc-sync — distribute the `oc` helper (and optionally the whole opencode config)
# to the remote hosts listed in .env.
#
# Usage:
#   bin/oc-sync                 sync `oc` to every host
#   bin/oc-sync --with-config   also rsync opencode.jsonc, pool-models.json, lib/, plugins/ and .opencode/
#   bin/oc-sync --dry-run ...   show what would change, write nothing
#   bin/oc-sync --host NAME ... limit to one host
#
# Host details are NOT in this file: this repo is public. They live in .env
# (gitignored), e.g. OC_HOSTS="host-a host-b"; see .env.example for every
# variable. If OC_HOSTS is unset the script falls back to ~/.oc-hosts.
#
# Why it is shaped this way:
#   * Command latency on these boxes varies wildly (measured 1.4s to 23s per
#     remote command). The original made ~12 ssh calls per host, so a slow host
#     took minutes and looked like a hang. All remote preparation now happens in
#     ONE ssh call that runs a small script and prints a log.
#   * Reaching a host by raw IP cost ~11.4s per call versus ~1.4s via its
#     ssh-config alias, so OC_HOSTS lists aliases, not addresses.
#   * A failing host must not abort the run, so nothing relies on `set -e`.
#   * Every ssh is wrapped in `timeout`; rc edits are idempotent.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"

# .env is gitignored and parsed as shell assignments, so OC_HOSTS and friends can
# be set there instead of exported by the caller. Sourced before the defaults
# below, so .env wins when both are present; with no .env, exported variables
# work on their own.
ENV_FILE="${OC_SYNC_ENV_FILE:-$REPO_DIR/.env}"
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

HOSTS_FILE="${OC_HOSTS_FILE:-$HOME/.oc-hosts}"
OC_SCRIPT="${OC_SCRIPT:-$SCRIPT_DIR/oc}"
CONFIG_DIR="${OC_SYNC_CONFIG_DIR:-$REPO_DIR}"
LOCAL_USER="${OC_LOCAL_USER:-$(whoami)}"
SSH_TIMEOUT="${OC_SYNC_SSH_TIMEOUT:-90}"
RSYNC_TIMEOUT="${OC_SYNC_RSYNC_TIMEOUT:-120}"
SSH_BASE=(ssh -n -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=15)
# remote_prepare feeds a script on stdin, so it must NOT use -n.
SSH_STDIN=(ssh -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=15)

WITH_CONFIG=0
DRY_RUN=0
ONLY_HOST=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --with-config) WITH_CONFIG=1 ;;
    --dry-run|-n)  DRY_RUN=1 ;;
    --host)        ONLY_HOST="${2:-}"; shift ;;
    -h|--help)     sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)             echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

ok()   { printf '  \xe2\x9c\x93 %s\n' "$*"; }
bad()  { printf '  \xe2\x9c\x97 %s\n' "$*"; }
warn() { printf '  \xe2\x9a\xa0 %s\n' "$*"; }

# rsync with the same ssh options, and --dry-run folded in. rsync's progress
# lines are noise here, but the transfer's exit status is the whole point: a
# filtered pipe reports success for a transfer that never happened, so the
# status is captured before filtering and returned to the caller.
rsync_to() {
  local src="$1" dest="$2"
  shift 2
  local args=(-az --no-owner --no-group)
  [[ $DRY_RUN -eq 1 ]] && args+=(-n)
  local out="" status=0
  out="$(timeout "$RSYNC_TIMEOUT" rsync "${args[@]}" "$@" \
    -e "ssh -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=15" \
    "$src" "$dest" 2>&1)" || status=$?
  printf '%s\n' "$out" | grep -vE 'using port|^$|^sending |^sent |^total size' || true
  return "$status"
}

# One rsync, with its failure reported and remembered, so a half-synced host can
# never be announced as done.
push() {
  local label="$1" src="$2" dest="$3"
  shift 3
  if rsync_to "$src" "$dest" "$@"; then
    ok "$label synced"
    return 0
  fi
  bad "rsync of $label FAILED ($src -> $dest) - remote copy is not up to date"
  FAILED+=("$HOST")
  return 1
}

# Host list: OC_HOSTS (whitespace or newline separated) wins, else the legacy
# ~/.oc-hosts file. Blank lines and # comments are ignored either way.
HOSTS=()
if [[ -n "${OC_HOSTS:-}" ]]; then
  # One host per line, or any mix of spaces, tabs, commas and newlines.
  mapfile -t HOSTS < <(printf '%s\n' "$OC_HOSTS" | tr ',[:space:]' '\n' | grep -v '^[[:space:]]*$')
elif [[ -f "$HOSTS_FILE" ]]; then
  mapfile -t HOSTS < <(sed -e 's/#.*$//' -e 's/[[:space:]]*$//' "$HOSTS_FILE" | grep -v '^$')
fi

if [[ ${#HOSTS[@]} -eq 0 ]]; then
  echo "Error: no hosts configured."
  echo "  Set OC_HOSTS in $ENV_FILE (see .env.example), or point OC_HOSTS_FILE at a list."
  exit 1
fi

# Local ssh key, used by the remote `oc` script for tunnel auth.
LOCAL_KEY_FILE=""
for F in "$HOME/.ssh/id_ed25519.pub" "$HOME/.ssh/id_rsa.pub" "$HOME/.ssh/id_ecdsa.pub"; do
  [[ -f "$F" ]] && LOCAL_KEY_FILE="$F" && break
done
if [[ -n "$LOCAL_KEY_FILE" ]]; then
  LOCAL_KEY="$(cat "$LOCAL_KEY_FILE")"
  if grep -qxF "$LOCAL_KEY" "$HOME/.ssh/authorized_keys" 2>/dev/null; then
    ok "local key already in ~/.ssh/authorized_keys"
  elif [[ $DRY_RUN -eq 1 ]]; then
    ok "[dry-run] would add your local public key to ~/.ssh/authorized_keys (for tunnel auth)"
  else
    mkdir -p "$HOME/.ssh"
    printf '%s\n' "$LOCAL_KEY" >> "$HOME/.ssh/authorized_keys"
    chmod 600 "$HOME/.ssh/authorized_keys"
    ok "added your local public key to ~/.ssh/authorized_keys (for tunnel auth)"
  fi
else
  warn "no SSH public key found locally - generate one with ssh-keygen"
fi

[[ -f "$OC_SCRIPT" ]] || { echo "Error: $OC_SCRIPT not found (set OC_SCRIPT to the oc helper)." >&2; exit 1; }
if [[ $WITH_CONFIG -eq 1 && ! -f "$CONFIG_DIR/opencode.jsonc" ]]; then
  echo "Error: $CONFIG_DIR/opencode.jsonc not found; cannot sync config." >&2
  exit 1
fi

# One ssh call per host: report identity, ensure ~/bin, put ~/bin on PATH,
# and set OC_LOCAL_USER. Prints "oc-sync|..." lines the caller renders.
remote_prepare() {
  local host="$1"
  timeout "$SSH_TIMEOUT" "${SSH_STDIN[@]}" "$host" bash -s -- "$LOCAL_USER" "$DRY_RUN" <<'REMOTE'
set -u
LOCAL_USER="$1"
# 1 = preview only: every mutation below is reported instead of performed, so
# that "nothing was written" is true of the remote host too.
DRY="$2"
emit() { echo "oc-sync|$1"; }
# add_line <rc-file> <exact-line> <what>
add_line() {
  [ -f ~/"$1" ] || return 0
  if grep -qxF "$2" ~/"$1" 2>/dev/null; then
    emit "ok:$3 already in ~${1}"
  elif [ "$DRY" = "1" ]; then
    emit "ok:[dry-run] would add $3 to ~${1}"
  elif printf '%s\n' "$2" >> ~/"$1" 2>/dev/null; then
    emit "ok:$3 added to ~${1}"
  else
    emit "warn:could not update ~${1}"
  fi
}
if [ "$DRY" = "1" ]; then
  if [ -d ~/bin ]; then emit "ok:~/bin exists"; else emit "ok:[dry-run] would create ~/bin"; fi
else
  mkdir -p ~/bin 2>/dev/null && emit "ok:ensured ~/bin exists" || emit "err:could not create ~/bin"
fi
case ":${PATH}:" in
  *":${HOME}/bin:"*) emit "ok:~/bin already in PATH" ;;
  *)
    PATH_LINE='export PATH="$HOME/bin:$PATH"'
    for RC in .bashrc .profile; do add_line "$RC" "$PATH_LINE" "~/bin PATH"; done ;;
esac
OC_LINE="export OC_LOCAL_USER=${LOCAL_USER}"
for RC in .bashrc .profile; do add_line "$RC" "$OC_LINE" "OC_LOCAL_USER=${LOCAL_USER}"; done
REMOTE
}

FAILED=()
DONE=()

for HOST in "${HOSTS[@]}"; do
  HOST="${HOST%$'\r'}"
  stripped="${HOST//[[:space:]]/}"
  [[ -z "$stripped" || "$HOST" == \#* ]] && continue
  [[ -n "$ONLY_HOST" && "$HOST" != "$ONLY_HOST" ]] && continue

  echo "━━━ Syncing to $HOST ━━━"

  PREP="$(remote_prepare "$HOST")"
  if [[ -z "$PREP" ]]; then
    bad "unreachable or too slow (>${SSH_TIMEOUT}s) - skipping, run continues"
    FAILED+=("$HOST")
    continue
  fi
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    msg="${line#oc-sync|}"
    case "$msg" in
      ok:*)   ok "${msg#ok:}" ;;
      warn:*) warn "${msg#warn:}" ;;
      err:*)  bad "${msg#err:}"; FAILED+=("$HOST") ;;
    esac
  done <<< "$PREP"

  if [[ " ${FAILED[*]-} " == *" $HOST "* ]]; then
    continue
  fi

  if [[ $DRY_RUN -eq 1 ]]; then
    ok "[dry-run] would rsync oc -> ~/bin/oc"
  elif rsync -az --no-owner --no-group \
        -e "ssh -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=15" \
        "$OC_SCRIPT" "${HOST}:~/bin/" >/dev/null 2>&1; then
    ok "oc script synced"
  else
    bad "rsync of oc failed"
    FAILED+=("$HOST")
    continue
  fi

  if [[ $WITH_CONFIG -eq 1 ]]; then
    echo "  --- opencode config ---"
    if [[ $DRY_RUN -eq 1 ]]; then
      ok "[dry-run] would rsync opencode.jsonc, pool-models.json, lib/, plugins/, .opencode/ (remote backed up first)"
    else
      if timeout "$SSH_TIMEOUT" "${SSH_BASE[@]}" "$HOST" \
           "tar czf ~/opencode-config-backup-\$(date +%Y%m%d-%H%M%S).tar.gz --ignore-failed-read -C ~/.config/opencode opencode.jsonc pool-models.json .opencode plugins lib 2>/dev/null" >/dev/null 2>&1; then
        ok "remote config backed up to ~/opencode-config-backup-*.tar.gz"
      else
        warn "remote backup failed - skipping config sync for this host"
        FAILED+=("$HOST")
        continue
      fi
      # lib/ must land before plugins/: the plugins import ../lib/pool.ts, so a
      # plugins-first sync would leave them unable to resolve on next restart.
      if [[ -d "$CONFIG_DIR/lib" ]]; then
        timeout "$SSH_TIMEOUT" "${SSH_BASE[@]}" "$HOST" 'mkdir -p ~/.config/opencode/lib' >/dev/null 2>&1
        push "lib/" "$CONFIG_DIR/lib/" "${HOST}:~/.config/opencode/lib/" || continue
      fi
      push "opencode.jsonc" "$CONFIG_DIR/opencode.jsonc" "${HOST}:~/.config/opencode/" || continue
      # pool-models.json decides which models the pool runs: lib/ and plugins/ read it,
      # so a host missing it silently falls back to the built-in defaults.
      if [[ -f "$CONFIG_DIR/pool-models.json" ]]; then
        push "pool-models.json" "$CONFIG_DIR/pool-models.json" "${HOST}:~/.config/opencode/" || continue
      fi
      if [[ -d "$CONFIG_DIR/plugins" ]]; then
        timeout "$SSH_TIMEOUT" "${SSH_BASE[@]}" "$HOST" 'mkdir -p ~/.config/opencode/plugins' >/dev/null 2>&1
        push "plugins/" "$CONFIG_DIR/plugins/" "${HOST}:~/.config/opencode/plugins/" || continue
      fi
      if [[ -d "$CONFIG_DIR/.opencode" ]]; then
        timeout "$SSH_TIMEOUT" "${SSH_BASE[@]}" "$HOST" 'mkdir -p ~/.config/opencode/.opencode' >/dev/null 2>&1
        # .opencode/context/ is the derived map of whatever projects a host
        # works on, so each host regenerates its own and it is never shipped.
        push ".opencode/" "$CONFIG_DIR/.opencode/" "${HOST}:~/.config/opencode/.opencode/" \
          --exclude='.opencode/context/' || continue
      fi
      # node_modules / package-lock.json / tests/ are intentionally not synced:
      # each host keeps its own install and SDK version.
    fi
  fi

  ok "done"
  DONE+=("$HOST")
done

# A host that neither finished nor recorded a failure was skipped by something
# unexpected (a missing helper, say). Never report that as success.
for HOST in "${HOSTS[@]}"; do
  case " ${DONE[*]-} ${FAILED[*]-} " in
    *" $HOST "*) ;;
    *) [[ -n "$ONLY_HOST" && "$HOST" != "$ONLY_HOST" ]] && continue
       bad "host $HOST was neither synced nor marked failed"
       FAILED+=("$HOST") ;;
  esac
done

echo
echo "━━━ Summary ━━━"
echo "  synced : ${DONE[*]:-none}"
if [[ ${#FAILED[@]} -gt 0 ]]; then
  echo "  failed : ${FAILED[*]}"
else
  echo "  failed : none"
fi
[[ $DRY_RUN -eq 1 ]] && echo "  dry run: nothing was written"
if [[ $WITH_CONFIG -eq 0 ]]; then
  echo
  echo "  note: this only synced the \`oc\` script."
  echo "        re-run with --with-config to also push opencode.jsonc, pool-models.json, lib/, plugins/ and .opencode/"
fi
[[ ${#FAILED[@]} -gt 0 ]] && exit 1
exit 0